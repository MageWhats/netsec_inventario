# Copia este archivo como .env.local y rellena los valores de tu proyecto Supabase
# (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: CAPTCHA del login con Cloudflare Turnstile (clave pública, "Site Key").
# Si se deja vacía, el login funciona sin CAPTCHA. Ver README → Seguridad.
VITE_TURNSTILE_SITE_KEY=
